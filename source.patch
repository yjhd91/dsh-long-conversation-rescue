new file mode 100644
index 00000000..aee3c7b9
--- /dev/null
+++ b/benchmarks/session-corpus/cold-history-retention.perf.ts
@@ -0,0 +1,82 @@
+/** Measure retained heap after consecutive reads of isolated synthetic Zstd histories. */
+import { mkdtemp, realpath, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { scheduler } from 'node:timers/promises'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId, SessionSeq, SESSION_FORMAT_VERSION } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SqliteSessionQueryEngine from '@deepseek-ai/dsh-session-query-sqlite'
+
+const SESSION_COUNT = 8
+const EVENTS_PER_SESSION = 768
+const CHARS_PER_EVENT = 32768
+
+function mib(bytes: number): number {
+  return Math.round(bytes / 104_857.6) / 10
+}
+
+async function heapAfterGc(): Promise<number> {
+  const gc = globalThis.gc
+  if (gc === undefined) throw new Error('Run with --expose-gc')
+  await scheduler.yield()
+  gc()
+  await scheduler.yield()
+  gc()
+  return mib(process.memoryUsage().heapUsed)
+}
+
+async function seed(ctx: Context, cwd: string): Promise<void> {
+  for (let index = 0; index < SESSION_COUNT; index++) {
+    const id = SessionId(`cold-${index}`)
+    await using writer = await ctx.sessionPersistence.create({
+      id, cwd, createdAt: index + 1, isSeeded: false, version: SESSION_FORMAT_VERSION,
+    })
+    for (let offset = 0; offset < EVENTS_PER_SESSION; offset += 64) {
+      const events = Array.from({ length: 64 }, (_, i): SessionEvent => {
+        const seq = offset + i
+        return {
+          type: 'user/message', seq: SessionSeq(seq), time: seq + 1, surfaceOp: 'append',
+          data: createUserMessage({
+            content: [{ type: 'text', text: `${index}/${seq}/${'λ'.repeat(CHARS_PER_EVENT)}` }],
+            source: { kind: 'user' },
+          }),
+        }
+      })
+      await writer.append(events)
+    }
+  }
+}
+
+async function readOnce(ctx: Context, index: number): Promise<number> {
+  using observation = await ctx.sessionQuery.observeSession(SessionId(`cold-${index}`), { projectionMode: 'none' })
+  if (observation.events.length !== EVENTS_PER_SESSION) throw new Error('Synthetic history changed')
+  return mib(process.memoryUsage().heapUsed)
+}
+
+const tempParent = await realpath(tmpdir())
+const root = await mkdtemp(join(tempParent, 'dsh-cold-history-perf-'))
+if (dirname(root) !== tempParent) throw new Error('Unexpected benchmark directory')
+const ctx = new Context()
+try {
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(JsonlSessionPersistence, { root: join(root, 'sessions'), compression: 'zstd' })
+  await ctx.plugin(SqliteSessionQueryEngine, { path: ':memory:', openAt: 'never' })
+  await seed(ctx, root)
+  const startMiB = await heapAfterGc()
+  const releasedMiB: number[] = []
+  let peakSampleMiB = 0
+  for (let index = 0; index < SESSION_COUNT; index++) {
+    peakSampleMiB = Math.max(peakSampleMiB, await readOnce(ctx, index))
+    releasedMiB.push(await heapAfterGc())
+  }
+  console.log(JSON.stringify({ startMiB, releasedMiB, peakSampleMiB }))
+} finally {
+  try {
+    await ctx.fiber.dispose()
+  } finally {
+    await rm(root, { recursive: true, force: true })
+  }
+}
